# Level 01 - "Escape": a three-sector gauntlet (corridor -> arena -> pit).
#
# One record per line: `record key=value ...`. Vectors are comma-separated.
# '#' starts a comment. Malformed lines are skipped and reported in the log.
# Record reference: src/game/Level.hpp.
#
# Units are metres. Y is up. Blocks are described on the X/Z plane:
#   block min=x,z max=x,z top=<height>                     flat-topped box
#   block ... h0=<h> h1=<h> axis=x|z                       ramp: height h0 at min[axis], h1 at max[axis]
#   base=<h> is the underside (default -0.2), door=<id> makes a closable door.
# Materials: concrete tile painted_metal steel brass flesh plastic emissive skin cloth leather

level name=level01_escape briefing=level01_outro next_level=kodiak_island next_spawn=from_level01_escape
# On completion the game plays the briefing assets/briefings/level01_outro.brf (ESC skips it),
# then loads the open Kodiak Island basin (kodiak_island.lvl), arriving on its beach.
# The staging hub (kodiak_hub) and the practice range stay reachable through the island's gate and
# the console (`level kodiak_hub`).
# Remove next_level=... to return to the main menu instead; remove briefing=... to skip the briefing.
spawn pos=0,0,10

# ---- Geometry ----------------------------------------------------------------

# Sector 0 - the corridor (X -6..6, Z 15 .. -75). Floor, side walls, end cap.
block min=-6,-75 max=6,15 top=0 color=0.38,0.38,0.36 material=tile
block min=-4,-75 max=-3,15 top=4.8 color=0.18,0.22,0.26 material=painted_metal
block min=3,-75 max=4,15 top=4.8 color=0.18,0.22,0.26 material=painted_metal

# Partition at Z -75: two wall pieces, a lintel, and door 0 (opens when sector 0 is cleared).
# visible=0 on a door: it is drawn dynamically so it can slide open.
block min=-16,-76 max=-3,-75 top=9.8 color=0.48,0.48,0.46 material=concrete
block min=3,-76 max=16,-75 top=9.8 color=0.48,0.48,0.46 material=concrete
block min=-3,-76 max=3,-75 top=9.8 base=4.8 color=0.48,0.48,0.46 material=concrete
block min=-3,-76 max=3,-75 top=4.8 color=0.25,0.25,0.28 material=steel visible=0 door=0
block min=-4,15 max=4,16 top=4.8 color=0.48,0.48,0.46 material=concrete

# Corridor ceiling slab.
block min=-4,-75 max=4,15 top=5.6 base=4.8 color=0.48,0.48,0.46 material=concrete

# Overhead light fixture strips (emissive boxes on the ceiling).
block min=-0.6,-66.5 max=0.6,-63.5 top=4.78 base=4.65 color=3,2.5,1.8 material=emissive
block min=-0.6,-51.5 max=0.6,-48.5 top=4.78 base=4.65 color=3,2.5,1.8 material=emissive
block min=-0.6,-36.5 max=0.6,-33.5 top=4.78 base=4.65 color=3,2.5,1.8 material=emissive
block min=-0.6,-21.5 max=0.6,-18.5 top=4.78 base=4.65 color=3,2.5,1.8 material=emissive
block min=-0.6,-6.5 max=0.6,-3.5 top=4.78 base=4.65 color=3,2.5,1.8 material=emissive
block min=-0.6,8.5 max=0.6,11.5 top=4.78 base=4.65 color=3,2.5,1.8 material=emissive

# Cover crates at the entry (Z ~0..4).
block min=-2.8,-2 max=-1.2,0 top=1.1 color=0.55,0.24,0.12 material=painted_metal
block min=1.5,2 max=2.8,4 top=1.4 color=0.55,0.24,0.12 material=painted_metal

# Low hurdle (Z -15): jump or vault over it.
block min=-3,-15.5 max=3,-14.8 top=0.9 color=0.25,0.25,0.28 material=steel

# Wall-run panels (Z -40..-28): run along these.
block min=-3,-40 max=-2.7,-28 top=4.5 color=0.25,0.25,0.28 material=steel
block min=2.7,-40 max=3,-28 top=4.5 color=0.25,0.25,0.28 material=steel

# Catwalk, ramp and platform (Z -62..-44).
block min=-2,-50 max=-0.2,-44 h0=2.2 h1=0 axis=z color=0.55,0.24,0.12 material=painted_metal
block min=-2,-58 max=-0.2,-50 top=2.2 color=0.48,0.48,0.46 material=concrete
block min=1.2,-62 max=2.8,-56 top=1.2 color=0.55,0.24,0.12 material=painted_metal

# Structural pillars: collision only (visible=0); a pillar prop mesh is drawn on each.
block min=-3,-60.4 max=-2.2,-59.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=2.2,-60.4 max=3,-59.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=-3,-45.4 max=-2.2,-44.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=2.2,-45.4 max=3,-44.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=-3,-30.4 max=-2.2,-29.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=2.2,-30.4 max=3,-29.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=-3,-15.4 max=-2.2,-14.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=2.2,-15.4 max=3,-14.6 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=-3,-0.4 max=-2.2,0.4 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0
block min=2.2,-0.4 max=3,0.4 top=4.8 color=0.48,0.48,0.46 material=concrete visible=0

# Sector 1 - the arena (X -16..16, Z -130..-76). Shell: floor, side walls, back wall.
block min=-16,-131 max=16,-75 top=0 color=0.36,0.36,0.34 material=tile
block min=-17,-131 max=-16,-75 top=9.8 color=0.18,0.22,0.26 material=painted_metal
block min=16,-131 max=17,-75 top=9.8 color=0.18,0.22,0.26 material=painted_metal
block min=-17,-131 max=-4,-130 top=9.8 color=0.48,0.48,0.46 material=concrete
block min=4,-131 max=17,-130 top=9.8 color=0.48,0.48,0.46 material=concrete

# Back wall lintel and the gate, door 1 (opens when sector 1 is cleared).
block min=-4,-131 max=4,-130 top=9.8 base=4.8 color=0.48,0.48,0.46 material=concrete
block min=-4,-131 max=4,-130 top=4.8 color=0.25,0.25,0.28 material=steel visible=0 door=1

# Arena ceiling.
block min=-17,-131 max=17,-75 top=10.6 base=9.8 color=0.48,0.48,0.46 material=concrete

# Stairs up the left wall: 10 steps, top at 3.5 m. Each rise (0.35) stays under stepHeight (0.4).
block min=-15.5,-78.8 max=-13,-78 top=0.35 color=0.25,0.25,0.28 material=steel
block min=-15.5,-79.6 max=-13,-78.8 top=0.7 color=0.25,0.25,0.28 material=steel
block min=-15.5,-80.4 max=-13,-79.6 top=1.05 color=0.25,0.25,0.28 material=steel
block min=-15.5,-81.2 max=-13,-80.4 top=1.4 color=0.25,0.25,0.28 material=steel
block min=-15.5,-82 max=-13,-81.2 top=1.75 color=0.25,0.25,0.28 material=steel
block min=-15.5,-82.8 max=-13,-82 top=2.1 color=0.25,0.25,0.28 material=steel
block min=-15.5,-83.6 max=-13,-82.8 top=2.45 color=0.25,0.25,0.28 material=steel
block min=-15.5,-84.4 max=-13,-83.6 top=2.8 color=0.25,0.25,0.28 material=steel
block min=-15.5,-85.2 max=-13,-84.4 top=3.15 color=0.25,0.25,0.28 material=steel
block min=-15.5,-86 max=-13,-85.2 top=3.5 color=0.25,0.25,0.28 material=steel

# Catwalks and bridge at 3.5 m (underside 2.9 m, walk beneath): left, back, right.
block min=-16,-128 max=-12.5,-86 top=3.5 base=2.9 color=0.25,0.25,0.28 material=steel
block min=-16,-128 max=16,-124 top=3.5 base=2.9 color=0.25,0.25,0.28 material=steel
block min=10,-128 max=16,-100 top=3.5 base=2.9 color=0.25,0.25,0.28 material=steel

# Slide ramp from the right catwalk down to the floor (Z -100 -> -84).
block min=10,-100 max=14,-84 h0=3.5 h1=0 axis=z color=0.55,0.24,0.12 material=painted_metal

# Floor cover and vault targets.
block min=-5,-100 max=-2,-98 top=1.1 color=0.55,0.24,0.12 material=painted_metal
block min=3,-110 max=6,-108 top=1.4 color=0.55,0.24,0.12 material=painted_metal
block min=-9,-116 max=-6,-114 top=1.1 color=0.55,0.24,0.12 material=painted_metal
block min=-1,-108 max=1,-106 top=3 color=0.48,0.48,0.46 material=concrete
block min=-4,-92 max=4,-91.4 top=0.9 color=0.25,0.25,0.28 material=steel

# Sector 2 - the pit (X -14..14, Z -170..-131, floor at -6). Shell.
block min=-14,-170 max=14,-131 top=-6 base=-6.2 color=0.3,0.3,0.3 material=tile
block min=-15,-171 max=-14,-131 top=4.8 base=-6.2 color=0.18,0.22,0.26 material=painted_metal
block min=14,-171 max=15,-131 top=4.8 base=-6.2 color=0.18,0.22,0.26 material=painted_metal
block min=-15,-171 max=15,-170 top=4.8 base=-6.2 color=0.48,0.48,0.46 material=concrete
block min=-15,-171 max=15,-131 top=5.6 base=4.8 color=0.48,0.48,0.46 material=concrete

# Ledge you drop from (floor 0).
block min=-4,-136 max=14,-131 top=0 base=-6.2 color=0.48,0.48,0.46 material=concrete

# Exit stairs: 17 steps, each 0.35 m lower.
block min=9,-136.8 max=13,-136 top=-0.35 base=-6.2 color=0.25,0.25,0.28 material=steel
