block min=9,-145.6 max=13,-144.8 top=-4.2 base=-6.2 color=0.25,0.25,0.28 material=steel
block min=9,-146.4 max=13,-145.6 top=-4.55 base=-6.2 color=0.25,0.25,0.28 material=steel
block min=9,-147.2 max=13,-146.4 top=-4.9 base=-6.2 color=0.25,0.25,0.28 material=steel
block min=9,-148 max=13,-147.2 top=-5.25 base=-6.2 color=0.25,0.25,0.28 material=steel
block min=9,-148.8 max=13,-148 top=-5.6 base=-6.2 color=0.25,0.25,0.28 material=steel
block min=9,-149.6 max=13,-148.8 top=-5.95 base=-6.2 color=0.25,0.25,0.28 material=steel

# Cover in the pit.
block min=-8,-152 max=-5,-150 top=-4.9 base=-6.2 color=0.55,0.24,0.12 material=painted_metal
block min=0,-160 max=3,-158 top=-4.6 base=-6.2 color=0.55,0.24,0.12 material=painted_metal

# Visible ceiling light fixtures (arena, then the red pit light).
block min=-9.2,-90.4 max=-6.8,-89.6 top=9.78 base=9.65 color=3,2.5,1.8 material=emissive
block min=6.8,-90.4 max=9.2,-89.6 top=9.78 base=9.65 color=3,2.5,1.8 material=emissive
block min=-9.2,-108.4 max=-6.8,-107.6 top=9.78 base=9.65 color=3,2.5,1.8 material=emissive
block min=6.8,-108.4 max=9.2,-107.6 top=9.78 base=9.65 color=3,2.5,1.8 material=emissive
block min=-9.2,-124.4 max=-6.8,-123.6 top=9.78 base=9.65 color=3,2.5,1.8 material=emissive
block min=6.8,-124.4 max=9.2,-123.6 top=9.78 base=9.65 color=3,2.5,1.8 material=emissive
block min=-1,-152 max=1,-148 top=4.78 base=4.65 color=3.2,0.5,0.35 material=emissive

# ---- Room lights (the nearest few are used per frame) --------------------------
# Arena and pit
light pos=-8,8.8,-90 color=10,8.2,6 radius=24
light pos=8,8.8,-90 color=10,8.2,6 radius=24
light pos=-8,8.8,-108 color=10,8.2,6 radius=24
light pos=8,8.8,-108 color=10,8.2,6 radius=24
light pos=-8,8.8,-124 color=10,8.2,6 radius=24
light pos=8,8.8,-124 color=10,8.2,6 radius=24
light pos=0,3,-134 color=5,2.2,1.6 radius=14
light pos=0,3.8,-150 color=8,1.2,0.8 radius=20
light pos=0,3.8,-164 color=6,1,0.8 radius=18
# Corridor
light pos=0,4.4,-65 color=9,7.4,5.4 radius=16
light pos=0,4.4,-50 color=9,7.4,5.4 radius=16
light pos=0,4.4,-35 color=9,7.4,5.4 radius=16
light pos=0,4.4,-20 color=9,7.4,5.4 radius=16
light pos=0,4.4,-5 color=9,7.4,5.4 radius=16
light pos=0,4.4,10 color=9,7.4,5.4 radius=16

# ---- Target dummies (respawning practice targets; patrol=<amplitude m> makes them pace) ----
target pos=0,0,2 patrol=2        # corridor entry patrol
target pos=-1.8,0,-10            # near the cover crate
target pos=1.8,0,-22 patrol=1.5
target pos=0,0,-32 patrol=2.5    # wall-run section
target pos=-1.5,0,-42
target pos=-1.1,2.2,-54          # upper catwalk
target pos=1.8,1.2,-60           # far platform
target pos=0,0,-70 patrol=2      # end of corridor

# ---- Pickups (yaw in radians) ---------------------------------------------------------
pickup kind=pipe   pos=1.6,0.06,4     yaw=0.4
pickup kind=bat    pos=-2.2,0.06,-8   yaw=1.2
pickup kind=barrel pos=2.3,0.45,-18
pickup kind=pipe   pos=-2.0,0.06,-26  yaw=2.0
pickup kind=barrel pos=-2.3,0.45,-37
pickup kind=bat    pos=1.4,0.06,-47   yaw=0.2

# ---- Enemies (sector >= 0: objective enemy, never respawns) ---------------------------
# Sector 0: the corridor. Clearing it opens door 0.
enemy pos=0,0,-6     type=melee  sector=0
enemy pos=1,0,-20    type=melee  sector=0
enemy pos=-1,0,-34   type=ranged sector=0
enemy pos=0,0,-68    type=ranged sector=0
# Sector 1: the arena. Clearing it opens the gate (door 1).
enemy pos=0,0,-100   type=melee  sector=1
enemy pos=-8,0,-105  type=ranged sector=1
enemy pos=8,0,-115   type=ranged sector=1
enemy pos=5,0,-120   type=melee  sector=1
# Sector 2: the pit. Clearing it completes the level.
enemy pos=0,-6,-145  type=melee  sector=2
enemy pos=6,-6,-152  type=melee  sector=2
enemy pos=-8,-6,-165 type=ranged sector=2

# ---- Triggers -------------------------------------------------------------------------
trigger when=sector_cleared sector=0 do=open_door door=0
trigger when=sector_cleared sector=1 do=open_door door=1
trigger when=sector_cleared sector=2 do=complete

# Checkpoints: entering the volume sets the respawn point.
trigger when=enter min=-16,-1,-92 max=16,6,-77 do=checkpoint point=0,0,-80    # arena entrance
trigger when=enter min=-4,-1,-136 max=14,2,-131 do=checkpoint point=5,0,-133  # pit ledge

# ---- Tutorial prompts -----------------------------------------------------------------
# Shown when the player enters the volume (once per run). The text fades after `time`
# seconds, or sooner once the player does what it teaches (clear_on=jump|slide|vault|
# wall_run|fire|grab|throw). {name} shows the player's current key for that action.
# Plain text only: letters, digits and . - + : ! % / < > [ ] , _ = ( ) ' " ? * # ; | \ @ ~
# Order in the level: movement and melee in the corridor, then guns and explosions in
# the arena, then seize -> shield -> throw in the pit.

# Corridor: movement
trigger when=enter min=-4,-1,8 max=4,4,15   do=prompt time=7 text="MOVE: {forward} {left} {back} {right}   SPRINT: {sprint}   JUMP: {jump}"
trigger when=enter min=-4,-1,0 max=4,4,7    do=prompt time=9 clear_on=grab text="{grab} PICKS UP A PIPE OR BAT - {lmb} SWINGS IT"
trigger when=enter min=-4,-1,-12 max=4,4,-6 do=prompt time=8 clear_on=vault text="HOLD {sprint} AND RUN INTO LOW COVER TO VAULT IT"
trigger when=enter min=-4,-1,-20 max=4,4,-16 do=prompt time=10 clear_on=throw text="{grab} GRABS A BARREL - {grab} AGAIN THROWS IT - IT EXPLODES ON IMPACT"
trigger when=enter min=-4,-1,-25 max=4,4,-21 do=prompt time=8 clear_on=slide text="CROUCH ({crouch}) WHILE SPRINTING TO SLIDE"
trigger when=enter min=-4,-1,-32 max=4,4,-26 do=prompt time=10 clear_on=wall_run text="SPRINT + JUMP AT A WALL TO WALL-RUN - JUMP AGAIN TO KICK OFF"
trigger when=enter min=-4,-1,-44 max=4,4,-40 do=prompt time=8 text="RUN UP RAMPS FOR HEIGHT - SLIDING DOWN ONE BUILDS SPEED"

# Corridor exit: guns
trigger when=enter min=-4,-1,-62 max=4,6,-56 do=prompt time=9 text="{lmb} FIRES - {reload_right} RELOADS - {weapon1} TO {weapon5} SWITCH WEAPONS"

# Arena: dual wield and explosions
trigger when=enter min=-16,-1,-90 max=16,6,-82 do=prompt time=10 text="HOLD {left_mod} + {weapon2} TO {weapon5} FOR A LEFT-HAND WEAPON - {rmb} FIRES IT"
trigger when=enter min=-16,-1,-110 max=16,6,-100 do=prompt time=10 text="ROCKETS ({weapon5}) BLAST GROUPS - FIRE AT YOUR FEET TO ROCKET JUMP"

# Pit: seize, shield, throw
trigger when=enter min=-4,-1,-136 max=14,2,-131 do=prompt time=14 clear_on=throw text="PUNCH TO STAGGER - {grab} SEIZES IT AS A SHIELD - {grab} AGAIN THROWS IT"
