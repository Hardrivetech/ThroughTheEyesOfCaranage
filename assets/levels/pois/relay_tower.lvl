# POI: the relay tower (a fenced compound with a tall tower, about 40 x 40 m). Included by kodiak_island.lvl.
#
# Written in its OWN coordinates (origin = the middle of the compound, the gate faces +Z), so it
# can be placed anywhere, turned in quarter turns and copied.
#   * door 0   the compound gate (opens when the guards are cleared)
#   * sector 0 the compound's guards
#   * named spawn `gate` (just outside the fence) becomes <prefix>_gate in the parent
# Format reference: src/game/Level.hpp.

# ---- Compound floor and fence (gate gap at x -3..3 on the +Z side) ----------------------------
block min=-20,-20 max=20,20 top=0.3 color=0.34,0.34,0.32 mat=concrete_worn
block min=-21,-21 max=21,-20 top=3.2 color=0.22,0.26,0.30 mat=metal_rusted
block min=-21,-20 max=-20,21 top=3.2 color=0.22,0.26,0.30 mat=metal_rusted
block min=20,-20 max=21,21 top=3.2 color=0.22,0.26,0.30 mat=metal_rusted
block min=-20,20 max=-3,21 top=3.2 color=0.22,0.26,0.30 mat=metal_rusted
block min=3,20 max=20,21 top=3.2 color=0.22,0.26,0.30 mat=metal_rusted
block min=-3,20 max=3,21 top=3.2 base=2.4 color=0.22,0.26,0.30 mat=metal_rusted
block min=-3,20 max=3,21 top=2.4 mat=hazard_trim visible=0 door=0
block min=-3.5,19.8 max=-3,21.2 top=3.4 mat=hazard_trim
block min=3,19.8 max=3.5,21.2 top=3.4 mat=hazard_trim

# ---- The tower: a stepped base, a shaft with wall-run faces, and a platform ----------------------
block min=-6,-6 max=6,6 top=1.2 color=0.40,0.40,0.38 mat=concrete_worn
block min=-3,-3 max=3,3 top=26 color=0.30,0.30,0.32 mat=metal_rusted
block min=-6,-3 max=-3,3 top=12 base=0.5 color=0.45,0.12,0.08 mat=hazard_trim
block min=-10,-10 max=10,10 top=26.6 base=26 mat=grate_industrial
# a ramp up to the first landing (it rises to exactly the landing's height, so there is no step)
block min=3,-3 max=12,3 h0=0.3 h1=5 axis=x mat=grate_industrial
block min=12,-3 max=14,3 top=5 mat=grate_industrial
block min=9,-9 max=14,-3 top=5 mat=grate_industrial
# aerial: the dish (decorative, collision only)
block min=-1,-1 max=1,1 top=34 base=26.6 color=0.65,0.65,0.68 material=steel
block min=-0.2,-0.2 max=0.2,0.2 top=38 base=34 color=3.2,0.2,0.1 material=emissive

# ---- Lights -----------------------------------------------------------------------------------
light pos=0,7,12 color=9,8,6 radius=30
light pos=0,7,-12 color=9,8,6 radius=30
light pos=0,30,0 color=9,1.5,1 radius=26
light pos=0,2.5,23 color=3.2,2.4,0.3 radius=12

# ---- Guards (sector 0) ----------------------------------------------------------------------------
enemy pos=-10,0.3,10 type=melee sector=0
enemy pos=10,0.3,12 type=ranged sector=0
enemy pos=0,0.3,-12 type=melee sector=0
enemy pos=-12,0.3,-10 type=ranged sector=0
enemy pos=13,5,0 type=ranged sector=0
trigger when=sector_cleared sector=0 do=open_door door=0

pickup kind=barrel pos=-14,0.75,4
pickup kind=pipe pos=14,0.36,-8 yaw=0.4
target pos=0,0.3,-15

# 28 m out is beyond the fence and the 0.3 m compound slab, on whatever ground the POI is placed on:
spawn name=gate pos=0,0,28 yaw=0
trigger when=enter min=-6,-1,10 max=6,4,17 do=checkpoint point=0,0.3,13
trigger when=enter min=-5,-1,24 max=5,4,32 do=prompt time=9 text="THE RELAY TOWER: CLEAR THE COMPOUND, THEN CLIMB - WALL-RUN THE RED PANEL"
