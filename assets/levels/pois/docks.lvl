# POI: the docks (a harbour yard, about 60 x 50 m). Included by kodiak_island.lvl.
#
# Written in its OWN coordinates, so it can be placed anywhere, turned in quarter turns and
# copied: the origin is the middle of the yard's landward edge and the sea is towards -Z.
# `include path=levels/pois/docks.lvl offset=x,y,z yaw=0|90|180|270 prefix=... door_offset=...`
#   * door 0   the warehouse roller door (opens when the yard's guards are cleared)
#   * sector 0 the yard's guards
#   * named spawn `landing` (the pier end) becomes <prefix>_landing in the parent
# Format reference: src/game/Level.hpp.

# ---- Quay and pier ---------------------------------------------------------------------------
# The quay is carved around the warehouse so its floor is a different surface (tile) that does not accumulate
# snow, with no two top faces overlapping: the warehouse footprint is x -30..-12, z -30..-2.
block min=-12,-50 max=30,0 top=0.8 color=0.40,0.40,0.38 mat=concrete_worn
block min=-30,-50 max=-12,-30 top=0.8 color=0.40,0.40,0.38 mat=concrete_worn
block min=-30,-2 max=-12,0 top=0.8 color=0.40,0.40,0.38 mat=concrete_worn
block min=-30,-30 max=-12,-2 top=0.8 color=0.38,0.38,0.36 mat=tile
block min=-3,-90 max=3,-50 top=0.8 mat=grate_industrial
# mooring bollards along the quay edge
block min=-24,-49 max=-23,-48 top=1.6 color=0.12,0.12,0.13 mat=metal_rusted
block min=-8,-49 max=-7,-48 top=1.6 color=0.12,0.12,0.13 mat=metal_rusted
block min=7,-49 max=8,-48 top=1.6 color=0.12,0.12,0.13 mat=metal_rusted
block min=23,-49 max=24,-48 top=1.6 color=0.12,0.12,0.13 mat=metal_rusted

# ---- Warehouse (west side): walls, roof and a roller door facing the yard --------------------
block min=-30,-30 max=-29,-2 top=6.5 color=0.22,0.26,0.30 mat=metal_rusted
block min=-30,-3 max=-12,-2 top=6.5 color=0.22,0.26,0.30 mat=metal_rusted
block min=-30,-30 max=-12,-29 top=6.5 color=0.22,0.26,0.30 mat=metal_rusted
block min=-13,-30 max=-12,-22 top=6.5 color=0.22,0.26,0.30 mat=metal_rusted
block min=-13,-14 max=-12,-3 top=6.5 color=0.22,0.26,0.30 mat=metal_rusted
block min=-13,-22 max=-12,-14 top=6.5 base=4.2 color=0.22,0.26,0.30 mat=metal_rusted
block min=-13,-22 max=-12,-14 top=4.2 mat=hazard_trim visible=0 door=0
block min=-30,-30 max=-12,-2 top=7.3 base=6.5 color=0.30,0.30,0.30 mat=concrete_worn
# hazard-yellow trim over the door (decorative)
block min=-13.3,-22 max=-12.7,-14 top=4.5 base=4.2 mat=hazard_trim

# ---- Container stacks: cover in the yard and a climbable route ---------------------------------
block min=-6,-30 max=0,-24 top=2.6 color=0.55,0.18,0.12 mat=metal_rusted
block min=-6,-30 max=0,-24 top=5.2 base=2.6 color=0.12,0.30,0.45 mat=metal_rusted
block min=4,-34 max=10,-28 top=2.6 color=0.12,0.30,0.45 mat=metal_rusted
block min=12,-22 max=18,-16 top=2.6 color=0.55,0.42,0.10 mat=metal_rusted
# a ramp up onto that container's roof, and a low hurdle to practise vaulting
block min=18,-22 max=24,-16 h0=2.6 h1=0.8 axis=x mat=grate_industrial
block min=-2,-12 max=8,-11.3 top=1.7 base=0.0 mat=hazard_trim
# a gantry crane frame: a landmark you can see across the yard
block min=22,-46 max=23,-45 top=11 color=0.55,0.10,0.08 mat=metal_rusted
block min=22,-26 max=23,-25 top=11 color=0.55,0.10,0.08 mat=metal_rusted
block min=22,-46 max=23,-25 top=11.8 base=11 color=0.55,0.10,0.08 mat=metal_rusted

# ---- Lights -----------------------------------------------------------------------------------
light pos=0,9,-10 color=9,8,6 radius=34
light pos=14,9,-35 color=9,8,6 radius=30
light pos=-20,6,-16 color=8,7,5 radius=20
light pos=0,4,-70 color=2,9,11 radius=22

# ---- The yard's guards (sector 0). Clearing them opens the warehouse door ------------------------
enemy pos=2,0.8,-14 type=melee sector=0
enemy pos=-5,0.8,-8 type=ranged sector=0
enemy pos=8,0.8,-40 type=melee sector=0
enemy pos=15,0.8,-30 type=ranged sector=0
trigger when=sector_cleared sector=0 do=open_door door=0

# ---- Practice targets and things to throw -----------------------------------------------------
target pos=20,0.8,-10 patrol=3
pickup kind=barrel pos=9,1.25,-12
pickup kind=pipe pos=-16,0.86,-1 yaw=1.2
pickup kind=bat pos=26,0.86,-20 yaw=2.4

# ---- Where the player comes ashore and the checkpoint -----------------------------------------
spawn name=landing pos=0,0.8,-85 yaw=180
trigger when=enter min=-8,-1,-12 max=8,4,-4 do=checkpoint point=0,0.8,-6
trigger when=enter min=-8,-1,-6 max=8,4,2 do=prompt time=9 text="THE DOCKS: CLEAR THE GUARDS TO OPEN THE WAREHOUSE DOOR"
