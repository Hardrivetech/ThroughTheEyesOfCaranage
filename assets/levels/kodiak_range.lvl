# Kodiak Island - proving ground. A small practice range: targets, enemies, pickups and cover.
# Reached through the east gate of the hub; the gate behind the spawn leads back.
# No objectives: it never "completes", you leave through the portal.
# Format reference: src/game/Level.hpp.

level name=kodiak_range
spawn pos=0,0,4 yaw=0
spawn name=from_kodiak_hub pos=0,0,4 yaw=0

# ---- Arena shell (X -15..15, Z -50..12) ------------------------------------------------------
block min=-15,-50 max=15,12 top=0 color=0.34,0.34,0.32 material=tile
block min=-16,-51 max=-15,13 top=6 color=0.18,0.22,0.26 material=painted_metal
block min=15,-51 max=16,13 top=6 color=0.18,0.22,0.26 material=painted_metal
block min=-16,-51 max=16,-50 top=6 color=0.18,0.22,0.26 material=painted_metal
block min=-16,12 max=16,13 top=6 color=0.18,0.22,0.26 material=painted_metal

# ---- Cover and a vault hurdle ------------------------------------------------------------------
block min=-6,-5 max=-3,-3 top=1.1 color=0.55,0.24,0.12 material=painted_metal
block min=3,-12 max=6,-10 top=1.4 color=0.55,0.24,0.12 material=painted_metal
block min=-15,-20 max=-3,-19.4 top=0.9 color=0.25,0.25,0.28 material=steel

# ---- Return gate to the hub (south wall) --------------------------------------------------------
block min=-3,10.9 max=-2.4,11.9 top=4.2 color=0.3,2.4,3 material=emissive
block min=2.4,10.9 max=3,11.9 top=4.2 color=0.3,2.4,3 material=emissive
block min=-3,10.9 max=3,11.9 top=4.8 base=4.2 color=0.3,2.4,3 material=emissive

light pos=0,5.5,0 color=9,8,6 radius=24
light pos=0,5.5,-25 color=9,8,6 radius=26
light pos=0,5.5,-45 color=9,6,4 radius=22
light pos=0,3.5,10 color=2,9,11 radius=12

# ---- Practice targets (patrol=<metres> makes them pace) -----------------------------------------
target pos=-8,0,-15 patrol=3
target pos=8,0,-25 patrol=2
target pos=0,0,-35 patrol=4
target pos=-6,0,-45
target pos=6,0,-45

# ---- Free-roaming enemies to spar with (no sector: they are not objectives) -----------------------
enemy pos=0,0,-42 type=melee
enemy pos=8,0,-46 type=ranged

# ---- Pickups ----------------------------------------------------------------------------------------
pickup kind=pipe   pos=-10,0.06,6 yaw=0.5
pickup kind=bat    pos=10,0.06,6 yaw=1
pickup kind=barrel pos=-8,0.45,-8
pickup kind=barrel pos=9,0.45,-30

# ---- Gate back to the hub --------------------------------------------------------------------------
trigger when=enter min=-2,-1,9 max=2,4,11.6 do=portal level=kodiak_hub spawn=from_kodiak_range

trigger when=enter min=-15,-1,-30 max=15,3,-20 do=checkpoint point=0,0,-24
trigger when=enter min=-6,-1,0 max=6,4,8 do=prompt time=9 text="PROVING GROUND - PRACTICE HERE. THE GATE BEHIND YOU LEADS BACK TO THE HUB"
