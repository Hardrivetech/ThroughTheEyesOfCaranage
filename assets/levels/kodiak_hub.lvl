# Kodiak Island - staging area. The hub between missions.
#
# One open outdoor area split into zones linked by doors (no streaming, one level):
#   landing pad (south)  ->  plaza (middle)  ->  command post (north, door 0)
#                                            \->  east yard (east, door 1)
# The doors open by themselves when the player walks up to them (an `enter` trigger
# with do=open_door). Each mission is a PORTAL: walking into the glowing gate loads another
# level (do=portal level=<id> [spawn=<name>]).
#
# Spawns (the places other levels send the player to):
#   default / from_level01_escape   the landing pad, facing north
#   from_kodiak_range               the east yard, facing west (away from the gate you came out of)
#   from_kodiak_island              the plaza's west side, facing east (away from the island gate)
# Format reference: src/game/Level.hpp. Yaw is in degrees: 0 faces -Z (north), 90 faces -X.

level name=kodiak_hub
environment snow=0.5
spawn pos=0,0.2,40 yaw=0
spawn name=from_level01_escape pos=0,0.2,40 yaw=0
spawn name=from_kodiak_range pos=24,0,-8.5 yaw=90
spawn name=from_kodiak_island pos=-23,0,25 yaw=-90

# ---- Ground and the island's outer cliffs -------------------------------------------------
# The ground is carved around the command post (x -14..14, z -59..-30) so its floor is a different surface (tile)
# that does not accumulate snow, and no two top faces overlap.
block min=-30,-61 max=-14,51 top=0 mat=asphalt_wet
block min=14,-61 max=31,51 top=0 mat=asphalt_wet
block min=-14,-30 max=14,51 top=0 mat=asphalt_wet
block min=-14,-61 max=14,-59 top=0 mat=asphalt_wet
block min=-14,-59 max=14,-30 top=0 color=0.38,0.38,0.36 mat=tile
block min=-31,-61 max=-30,51 top=7 color=0.18,0.22,0.26 mat=concrete_worn
block min=30,-61 max=31,51 top=7 color=0.18,0.22,0.26 mat=concrete_worn
block min=-30,50 max=30,51 top=7 color=0.18,0.22,0.26 mat=concrete_worn
block min=-30,-61 max=30,-60 top=7 color=0.18,0.22,0.26 mat=concrete_worn

# ---- Landing pad (south) --------------------------------------------------------------------
block min=-8,28 max=8,46 top=0.2 mat=grate_industrial
block min=-14,30 max=-11,33 top=1.1 color=0.55,0.24,0.12 mat=metal_rusted
block min=11,36 max=14,39 top=1.4 color=0.55,0.24,0.12 mat=metal_rusted

# ---- Plaza west gate: to the open Kodiak Basin (the decorative frame; the portal trigger is below) ---
block min=-30,21.4 max=-29,22 top=4.2 color=0.3,2.4,3 mat=portal
block min=-30,28 max=-29,28.6 top=4.2 color=0.3,2.4,3 mat=portal
block min=-30,21.4 max=-29,28.6 top=4.8 base=4.2 color=0.3,2.4,3 mat=portal

# ---- Plaza (middle): cover, a vault hurdle, and a ramp up to a platform ---------------------
block min=-4,-6 max=-1.5,-3.5 top=1.1 color=0.55,0.24,0.12 mat=metal_rusted
block min=2,2 max=5,4.5 top=1.4 color=0.55,0.24,0.12 mat=metal_rusted
block min=3,8 max=12,8.7 top=0.9 mat=hazard_trim
block min=-18,0 max=-12,12 h0=2 h1=0 axis=z mat=grate_industrial
block min=-20,-10 max=-12,0 top=2 mat=grate_industrial

# ---- Command post (north): south wall with door 0, side and back walls, roof ----------------
block min=-14,-31 max=-4,-30 top=6 color=0.48,0.48,0.46 mat=concrete_worn
block min=4,-31 max=14,-30 top=6 color=0.48,0.48,0.46 mat=concrete_worn
block min=-4,-31 max=4,-30 top=6 base=4.2 color=0.48,0.48,0.46 mat=concrete_worn
block min=-4,-31 max=4,-30 top=4.2 mat=hazard_trim visible=0 door=0
block min=-14,-58 max=-13,-31 top=6 color=0.18,0.22,0.26 mat=metal_rusted
block min=13,-58 max=14,-31 top=6 color=0.18,0.22,0.26 mat=metal_rusted
block min=-14,-59 max=14,-58 top=6 color=0.18,0.22,0.26 mat=metal_rusted
block min=-14,-59 max=14,-30 top=6.8 base=6 color=0.48,0.48,0.46 mat=concrete_worn
block min=-10,-40 max=-6,-38 top=1 mat=hazard_trim
block min=6,-40 max=10,-38 top=1 mat=hazard_trim
block min=-1,-45 max=1,-35 top=5.98 base=5.85 color=3,2.5,1.8 material=emissive
# Mission gate: ESCAPE (the glowing frame is decoration; the portal trigger is below)
block min=-3.2,-57.5 max=-2.6,-56.5 top=4.2 color=0.3,2.4,3 mat=portal
block min=2.6,-57.5 max=3.2,-56.5 top=4.2 color=0.3,2.4,3 mat=portal
block min=-3.2,-57.5 max=3.2,-56.5 top=4.8 base=4.2 color=0.3,2.4,3 mat=portal

# ---- East yard: west wall with door 1, north and south walls --------------------------------
block min=16,-30 max=17,-10 top=5 color=0.48,0.48,0.46 mat=concrete_worn
block min=16,-4 max=17,0 top=5 color=0.48,0.48,0.46 mat=concrete_worn
block min=16,-10 max=17,-4 top=5 base=4.2 color=0.48,0.48,0.46 mat=concrete_worn
block min=16,-10 max=17,-4 top=4.2 mat=hazard_trim visible=0 door=1
block min=16,-31 max=30,-30 top=5 color=0.48,0.48,0.46 mat=concrete_worn
block min=16,0 max=30,1 top=5 color=0.48,0.48,0.46 mat=concrete_worn
block min=19,-24 max=22,-22 top=1.1 color=0.55,0.24,0.12 mat=metal_rusted
# Mission gate: PROVING GROUND (practice range)
block min=28.6,-17.5 max=29.6,-16.9 top=4.2 color=0.3,2.4,3 mat=portal
block min=28.6,-13.1 max=29.6,-12.5 top=4.2 color=0.3,2.4,3 mat=portal
block min=28.6,-17.5 max=29.6,-12.5 top=4.8 base=4.2 color=0.3,2.4,3 mat=portal

# ---- Lights ----------------------------------------------------------------------------------
light pos=0,7,40 color=9,8,6 radius=24
light pos=0,7,10 color=9,8,6 radius=26
light pos=-14,7,-12 color=8,7,5 radius=22
light pos=0,5,-40 color=9,7.4,5.4 radius=20
light pos=0,3.5,-55 color=2,9,11 radius=14
light pos=23,4.5,-9 color=9,8,6 radius=20
light pos=27,3.5,-15 color=2,9,11 radius=12

# ---- Pickups for the yard ----------------------------------------------------------------------
pickup kind=barrel pos=21,0.45,-18
pickup kind=pipe   pos=24,0.06,-26 yaw=0.8
pickup kind=bat    pos=20,0.06,-4 yaw=2.2

# ---- Doors open when the player walks up to them (from either side) ---------------------------
trigger when=enter min=-6,-1,-26 max=6,4,-20 do=open_door door=0
trigger when=enter min=-6,-1,-37 max=6,4,-32 do=open_door door=0
trigger when=enter min=10,-1,-12 max=15,4,-2 do=open_door door=1
trigger when=enter min=18,-1,-12 max=22,4,-2 do=open_door door=1

# ---- Mission gates (portals) ---------------------------------------------------------------------
trigger when=enter min=-2.5,-1,-57.5 max=2.5,4,-55 do=portal level=level01_escape
trigger when=enter min=27,-1,-16.9 max=29.9,4,-13.1 do=portal level=kodiak_range
trigger when=enter min=-29.5,-1,22.2 max=-27.5,4,27.8 do=portal level=kodiak_island spawn=from_kodiak_hub

# ---- Checkpoints: one per zone ---------------------------------------------------------------------
trigger when=enter min=-9,-1,27 max=9,3,47 do=checkpoint point=0,0.2,40
trigger when=enter min=-12,-1,-8 max=12,3,12 do=checkpoint point=0,0,0
trigger when=enter min=-13,-1,-56 max=13,3,-32 do=checkpoint point=0,0,-50
trigger when=enter min=18,-1,-28 max=29,3,-2 do=checkpoint point=22,0,-8.5

# ---- Prompts ---------------------------------------------------------------------------------------
trigger when=enter min=-9,-1,36 max=9,4,47 do=prompt time=7 text="KODIAK ISLAND - STAGING AREA. HEAD NORTH."
trigger when=enter min=-12,-1,12 max=12,4,26 do=prompt time=8 text="THE COMMAND POST (NORTH) AND THE EAST YARD LEAD TO MISSIONS"
trigger when=enter min=-6,-1,-52 max=6,4,-44 do=prompt time=9 text="WALK INTO THE GATE TO REPLAY LEVEL 01 - ESCAPE"
trigger when=enter min=-26,-1,18 max=-18,4,32 do=prompt time=9 text="THE WEST GATE LEADS TO KODIAK BASIN - THE OPEN ISLAND"
trigger when=enter min=20,-1,-17 max=26,4,-13 do=prompt time=9 text="WALK INTO THE GATE FOR THE PROVING GROUND (PRACTICE RANGE)"
