// Simple humanoid mesh in binary format
// This is a placeholder file - in a real implementation, this would be generated
// by the generateHumanoid() function in Humanoid.cpp

// Binary mesh format header
struct MeshHeader {
    uint32_t magic = 0x4D455348; // "MESH"
    uint32_t version = 1;
    uint32_t vertexCount = 0;
    uint32_t indexCount = 0;
    glm::vec3 boundsMin = {0, 0, 0};
    glm::vec3 boundsMax = {0, 0, 0};
};

